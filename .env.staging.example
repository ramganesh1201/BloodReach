# ============================================================================
# CareLoop — Staging Environment Configuration Template
# File: .env.staging.example
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.staging` or `.env.local` for staging testing.
# 2. Populate values from your dedicated STAGING Supabase project dashboard.
# 3. DO NOT COMMIT `.env.staging` OR ANY REAL CREDENTIALS TO VERSION CONTROL.
# ============================================================================

# STAGING SUPABASE CONFIGURATION (Client-Safe Publishable Credentials)
# Replace with your dedicated CareLoop staging project URL (e.g. https://xyzstaging.supabase.co)
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# Replace with the staging project's public anon / publishable key
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here
# Optional alias supported by CareLoop client:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-anon-key-here

# ============================================================================
# WEBRTC ICE & STUN DISCOVERY CONFIGURATION
# ============================================================================
# NOTE: The fallback server below provides STUN (RFC 8489) NAT discovery only.
# IT DOES NOT PROVIDE TURN RELAY FALLBACK.
# TURN relay transport (RFC 8656) requires ephemeral time-limited credentials
# generated securely on the backend via the `issue_ice_credentials` or
# `get_ephemeral_turn_credentials` PostgreSQL RPCs.
# 
# Canonical Staging STUN Discovery Hostname:
VITE_STUN_SERVER_FALLBACK=stun:turn-staging.careloop.org:3478

# Signaling Timing Configuration (milliseconds)
VITE_CALL_RINGING_TIMEOUT_MS=30000
VITE_CALL_KEEPALIVE_INTERVAL_MS=5000

# ============================================================================
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION (Web Push Public Credentials)
# ============================================================================
# Obtain these values from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=replace-with-your-staging-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-staging-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-your-staging-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-your-staging-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-staging-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=1:replace-with-your-staging-firebase-app-id

# Web Push Public VAPID Key:
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=replace-with-your-staging-firebase-vapid-key

# ============================================================================
# SECURITY NOTICE — STRICT EMBEDDING PREVENTION
# ============================================================================
# The following credentials MUST NEVER be added to any VITE_ variable or client file:
# 1. SUPABASE SERVICE_ROLE KEY (bypasses all PostgreSQL Row Level Security)
# 2. POSTGRESQL DIRECT CONNECTION STRINGS (postgres://postgres:<password>@...)
# 3. COTURN HMAC STATIC AUTH SECRET ('turn_shared_secret' in Supabase Vault)
# 4. EDGE FUNCTION SERVICE SECRETS
# 5. SMS / CELLULAR PROVIDER SECRET API KEYS (Twilio, MSG91, Karix)
# 6. FIREBASE SERVICE ACCOUNT PRIVATE KEYS (FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL)
#
# Backend push secrets (FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY)
# must be placed strictly in Supabase Edge Function Secrets and never prefixed with VITE_.
#
# Server-side SMS secrets (SMS_GATEWAY_API_KEY, SMS_SENDER_ID, SMS_PROVIDER)
# must be placed strictly in server-side configuration (Vercel Serverless Function
# environment variables or Supabase Edge Function Secrets) and never prefixed with VITE_.
# Client bundles communicate exclusively via `/api/dispatch-sms` or Supabase Functions.
# 
# Ephemeral TURN credentials are automatically generated server-side inside
# PostgreSQL via the RPC `get_ephemeral_turn_credentials` with a strict 600-second
# TTL and per-user advisory rate limiting. The long-lived shared secret NEVER
# reaches client bundles or browser JavaScript.
# ============================================================================

